;; "" !LCTL_LAYER """""""""""""""""""""""""""""""""""""""""""""""""""""""""""
(deflayermap (!lctl|select_layer)
  (t! map_layers "$action_!lctl|select" "!lctl|select" ($<lalt $>lalt $<lmet $>lmet $lsft $rsft $!lalt $!lmet lsft rsft))
  (t! map_keys   "$action_!lctl|select"                ($<lalt $>lalt $<lmet $>lmet $lsft $rsft))
  spc $action_!lctl|select+spc
  $invert|keyb (t! invert_apps_sort $toggle_!lctl|select_layer)
)

(deflayermap (!lctl|select+lsft_layer)
  (t! map_layers "$action_!lctl|select+lsft" "!lctl|select+lsft" ($<lalt $>lalt $<lmet $>lmet $!lalt $!lmet))
  (t! map_keys   "$action_!lctl|select+lsft"                     ($<lalt $>lalt $<lmet $>lmet ))
  spc $action_!lctl|select+lsft+spc
  $invert|keyb (t! invert_apps_sort $toggle_!lctl|select+lsft_layer)
)

(deflayermap (!lctl|select+rsft_layer)
  (t! map_layers "$action_!lctl|select+rsft" "!lctl|select+rsft" ($<lalt $>lalt $<lmet $>lmet $!lalt $!lmet))
  (t! map_keys   "$action_!lctl|select+rsft"                     ($<lalt $>lalt $<lmet $>lmet ))
  spc $action_!lctl|select+rsft+spc
  $invert|keyb (t! invert_apps_sort $toggle_!lctl|select+rsft_layer)
)

