;; This file is a placeholder interface, not a real one: the actions below
;; (esc+esc, d, i, spc, ...) are not routed from any layer in layers/*.kbd
;; and are never actually run. They exist only so kanata_gen_help.py picks
;; them up as root actions and generates a help entry for the combo — pure
;; documentation for combos that are handled elsewhere (or informally), not
;; live bindings. Adding an entry here has no effect on what your keyboard
;; does; it only affects what shows up in the generated help overlay.
(defvar
  action_help+spc (t! unmod_all (switch ;;@iface@
    ((input virtual vk_apps_sort_desc)) (switch 
      ((input virtual vk_nvim)) $nvim_action_help+spc break
      () XX break
    ) break
    () (switch 
      ((input virtual vk_nvim)) $nvim_action_help+spc break
      () XX break
    ) break
  ))

  action_help+tab (t! unmod_all (switch ;;@iface@
    ((input virtual vk_apps_sort_desc)) (switch 
      ((input virtual vk_foot)) $foot_action_help+tab break
      () XX break
    ) break
    () (switch 
      ((input virtual vk_foot)) $foot_action_help+tab break
      () XX break
    ) break
  ))
  
  action_help+esc (t! unmod_all (switch ;;@iface@
    ((input virtual vk_apps_sort_desc)) (switch 
      ((input virtual vk_foot)) $foot_action_help+esc break
      () XX break
    ) break
    () (switch 
      ((input virtual vk_foot)) $foot_action_help+esc break
      () XX break
    ) break
  ))

  action_help+esc+esc (t! unmod_all (switch ;;@iface@
    ((input virtual vk_apps_sort_desc)) (switch 
      ((input virtual vk_foot)) $foot_action_help+esc+esc break
      () XX break
    ) break
    () (switch 
      ((input virtual vk_foot)) $foot_action_help+esc+esc break
      () XX break
    ) break
  ))

  action_help+H (t! unmod_all (switch ;;@iface@
    ((input virtual vk_apps_sort_desc)) (switch 
      ((input virtual vk_foot)) $foot_action_help+H break
      () XX break
    ) break
    () (switch 
      ((input virtual vk_foot)) $foot_action_help+H break
      () XX break
    ) break
  ))

  action_help+L (t! unmod_all (switch ;;@iface@
    ((input virtual vk_apps_sort_desc)) (switch 
      ((input virtual vk_foot)) $foot_action_help+L break
      () XX break
    ) break
    () (switch 
      ((input virtual vk_foot)) $foot_action_help+L break
      () XX break
    ) break
  ))

  action_help+d (t! unmod_all (switch ;;@iface@
    ((input virtual vk_apps_sort_desc)) (switch 
      ((input virtual vk_nvim)) $nvim_action_help+d break
      () XX break
    ) break
    () (switch 
      ((input virtual vk_nvim)) $nvim_action_help+d break
      () XX break
    ) break
  ))

  action_help+i (t! unmod_all (switch ;;@iface@
    ((input virtual vk_apps_sort_desc)) (switch 
      ((input virtual vk_nvim)) $nvim_action_help+i break
      ((input virtual vk_foot)) $foot_action_help+i break
      () XX break
    ) break
    () (switch 
      ((input virtual vk_foot)) $foot_action_help+i break
      ((input virtual vk_nvim)) $nvim_action_help+i break
      () XX break
    ) break
  ))

  action_help+p (t! unmod_all (switch ;;@iface@
    ((input virtual vk_apps_sort_desc)) (switch 
      ((input virtual vk_foot)) $foot_action_help+p break
      () XX break
    ) break
    () (switch 
      ((input virtual vk_foot)) $foot_action_help+p break
      () XX break
    ) break
  ))

  action_help+v (t! unmod_all (switch ;;@iface@
    ((input virtual vk_apps_sort_desc)) (switch 
      ((input virtual vk_foot)) $foot_action_help+v break
      () XX break
    ) break
    () (switch 
      ((input virtual vk_foot)) $foot_action_help+v break
      () XX break
    ) break
  ))

  action_help+y (t! unmod_all (switch ;;@iface@
    ((input virtual vk_apps_sort_desc)) (switch 
      ((input virtual vk_foot)) $foot_action_help+y break
      () XX break
    ) break
    () (switch 
      ((input virtual vk_foot)) $foot_action_help+y break
      () XX break
    ) break
  ))
)
