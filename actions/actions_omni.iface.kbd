(defvar
  ;; Navigation / Edit
  cancel          esc
  space           spc
  delete          del
  page_up         pgup
  page_down       pgdn
  nav_left        left
  nav_down        down
  nav_up          up
  nav_right       right
  nav_next        right
  nav_prev        left
  undo            C-z
  redo            C-S-z
  ;; Clipboard
  copy            C-c
  copy_path       C-S-c
  paste           C-v
  cut             C-x
  ;; Other operations
  window_close    $windows_close
  settings        $action_domains+,+,
  tags            $action_domains+.+.
  help            $action_domains+/+/
  panes_toggle    $action_panes+toggle
  tabs_toggle     $action_tabs+toggle
  apps_toggle     $windows_toggle 
  groups_toggle   $action_groups+toggle
  sessions_toggle $action_sessions+toggle
)

(defvar
  ;; This file is intended to be written by the user, and its action
  ;; dispatch is regenerated by the kanata_sync_apps.py script through the
  ;; Napp_action templates (see templates.kbd). The name of the action is
  ;; up to the user; to have the script keep it in sync with which apps
  ;; implement it, write it as:
  ;;
  ;;   (t! Napp_action <name> <default> <app1> <app2> ... <appN>)
  ;;
  ;; Example:
  ;;   (t! 2app_action action_lctl+a XX nvim obsidian)
  ;;
  ;; N is the number of apps that implement the action (0app_action for
  ;; none). <default> is the fallback used when no listed app is focused.
  ;; Each <appK> is an app name (matching its vk_<app> virtual key),
  ;; listed in priority order: when more than one app is focused at once
  ;; (e.g. nvim inside a tmux session), the first one in the list wins.
  ;; That priority order can be flipped live via the vk_apps_sort_desc
  ;; virtual key, which the template handles internally.
  ;;
  ;; Each app that wants its action autogenerated needs to define
  ;; <app>_action_<name> (same name as here, with the app prefix) in its
  ;; own actions/<app>/<app>_<iface>.kbd file. kanata_sync_apps.py scans
  ;; those files to build the <app1>...<appN> list for each action; the
  ;; default order of apps in the filename-less case is alphabetical, and
  ;; can be overridden with a numeric priority suffix on the per-app file
  ;; (e.g. action_nvim.1.kbd precedes action_chrome.10.kbd).

  ;; == omni ============================================================

  ;; omni
  ;; If not implemented, defaults to: esc
  (t! 1app_action action_omni $cancel colab)

  ;; omni + spc
  ;; If not implemented, defaults to: spc
  (t! 4app_action action_omni+spc $space nvim tmux obsidian dolphin)

  ;; omni + ent
  (t! 3app_action action_omni+ent XX nvim tmux dolphin)

  ;; omni + bcsp
  (t! 2app_action action_omni+bcsp $delete dolphin colab)

  ;; omni + a
  (t! 4app_action action_omni+a XX nvim tmux obsidian dolphin)
  ;; omni + lsft + a
  (t! 4app_action action_omni+lsft+a XX nvim tmux obsidian dolphin)
  ;; omni + rsft + a
  (t! 4app_action action_omni+rsft+a XX nvim tmux obsidian dolphin)

  ;; omni + b
  ;; If not implemented, defaults to: pgup
  (t! 4app_action action_omni+b $page_up nvim tmux foot obsidian)

  ;; omni + c
  ;; If not implemented, defaults to: C-c
  (t! 5app_action action_omni+c $copy nvim tmux foot obsidian dolphin)
  ;; omni + lsft + c
  ;; If not implemented, defaults to: C-S-c
  (t! 3app_action action_omni+lsft+c $copy_path nvim tmux dolphin)
  ;; omni + rsft + c
  ;; If not implemented, defaults to: C-S-c
  (t! 3app_action action_omni+rsft+c $copy_path nvim tmux dolphin)
  ;; omni + c + left
  (t! 3app_action action_omni+c+left XX nvim tmux dolphin)
  ;; omni + c + right
  (t! 3app_action action_omni+c+right XX nvim tmux dolphin)

  ;; omni + d
  (t! 4app_action action_omni+d XX nvim tmux obsidian dolphin)

  ;; omni + e
  (t! 4app_action action_omni+e XX nvim tmux foot dolphin)
  ;; omni + lsft + e
  (t! 4app_action action_omni+lsft+e XX nvim tmux foot dolphin)

  ;; omni + f
  ;; If not implemented, defaults to: pgdn
  (t! 4app_action action_omni+f $page_down nvim tmux foot obsidian)

  ;; omni + g
  (t! 8app_action action_omni+g XX whatsapp nvim tmux chrome zapzap obsidian dolphin firefox)

  ;; omni + h
  ;; If not implemented, defaults to: left
  (t! 1app_action action_omni+h $nav_left nvim)

  ;; omni + i
  (t! 3app_action action_omni+i XX nvim tmux dolphin)

  ;; omni + j
  ;; If not implemented, defaults to: down
  (t! 1app_action action_omni+j $nav_down nvim)

  ;; omni + k
  ;; If not implemented, defaults to: up
  (t! 1app_action action_omni+k $nav_up nvim)

  ;; omni + l
  ;; If not implemented, defaults to: right
  (t! 1app_action action_omni+l $nav_right nvim)

  ;; omni + m
  ;; If not implemented, defaults to: action_domainM+M
  (t! 1app_action action_omni+m $clipboard_history nvim)

  ;; omni + n
  (t! 9app_action action_omni+n XX whatsapp nvim tmux chrome zapzap obsidian dolphin firefox colab)
  ;; omni + lsft + n
  (t! 7app_action action_omni+lsft+n XX whatsapp nvim tmux zapzap obsidian dolphin colab)
  ;; omni + rsft + n
  (t! 7app_action action_omni+rsft+n XX whatsapp nvim tmux zapzap obsidian dolphin colab)

  ;; omni + o
  ;; If not implemented, defaults to: right
  (t! 4app_action action_omni+o $nav_next nvim tmux obsidian dolphin)

  ;; omni + p
  ;; If not implemented, defaults to: left
  (t! 4app_action action_omni+p $nav_prev nvim tmux obsidian dolphin)

  ;; omni + q
  ;; If not implemented, defaults to: action_windows_close
  (t! 4app_action action_omni+q $window_close whatsapp nvim tmux zapzap)

  ;; omni + r
  (t! 4app_action action_omni+r XX nvim tmux obsidian dolphin)

  ;; omni + s
  (t! 3app_action action_omni+s XX nvim tmux dolphin)
  ;; omni + lsft + s | omni + rsft + s
  (t! 3app_action action_omni+lsft+s XX nvim tmux dolphin)

  ;; omni + t
  ;; If not implemented, defaults to: action_tabs+t
  (t! 3app_action action_omni+t $action_tabs+t nvim tmux dolphin)
  ;; omni + lsft + t
  ;; If not implemented, defaults to: action_tabs+lsft+t
  (t! 3app_action action_omni+lsft+t $action_tabs+lsft+t nvim tmux dolphin)

  ;; omni + u
  (t! 3app_action action_omni+u XX nvim tmux dolphin)

  ;; omni + v
  ;; If not implemented, defaults to: C-v
  (t! 5app_action action_omni+v $paste nvim tmux foot obsidian dolphin)

  ;; omni + w
  ;; If not implemented, defaults to: action_tabs+w
  (t! 3app_action action_omni+w $action_tabs+w nvim tmux dolphin)

  ;; omni + x
  ;; If not implemented, defaults to: C-x
  (t! 4app_action action_omni+x $cut nvim tmux obsidian dolphin)
  ;; omni + x + left
  (t! 3app_action action_omni+x+left XX nvim tmux dolphin)
  ;; omni + x + right
  (t! 3app_action action_omni+x+right XX nvim tmux dolphin)
  
  ;; omni + y
  (t! 4app_action action_omni+y XX nvim tmux foot dolphin)

  ;; omni + z
  ;; If not implemented, defaults to: C-z
  (t! 3app_action action_omni+z $undo nvim tmux dolphin)
  ;; omni + lsft + z
  ;; If not implemented, defaults to: C-S-z
  (t! 3app_action action_omni+lsft+z $redo nvim tmux dolphin)


  ;; omni + 0
  ;; If not implemented, defaults to: C-0
  (t! 3app_action action_omni+0 $tab_goto_0 nvim tmux dolphin)
  ;; omni + 1
  ;; If not implemented, defaults to: C-1
  (t! 5app_action action_omni+1 $tab_goto_1 whatsapp nvim tmux zapzap dolphin)
  ;; omni + 2
  ;; If not implemented, defaults to: C-2
  (t! 5app_action action_omni+2 $tab_goto_2 whatsapp nvim tmux zapzap dolphin)
  ;; omni + 3
  ;; If not implemented, defaults to: C-3
  (t! 5app_action action_omni+3 $tab_goto_3 whatsapp nvim tmux zapzap dolphin)
  ;; omni + 4
  ;; If not implemented, defaults to: C-4
  (t! 5app_action action_omni+4 $tab_goto_4 whatsapp nvim tmux zapzap dolphin)
  ;; omni + 5
  ;; If not implemented, defaults to: C-5
  (t! 5app_action action_omni+5 $tab_goto_5 whatsapp nvim tmux zapzap dolphin)
  ;; omni + 6
  ;; If not implemented, defaults to: C-6
  (t! 5app_action action_omni+6 $tab_goto_6 whatsapp nvim tmux zapzap dolphin)
  ;; omni + 7
  ;; If not implemented, defaults to: C-7
  (t! 5app_action action_omni+7 $tab_goto_7 whatsapp nvim tmux zapzap dolphin)
  ;; omni + 8
  ;; If not implemented, defaults to: C-8
  (t! 5app_action action_omni+8 $tab_goto_8 whatsapp nvim tmux zapzap dolphin)
  ;; omni + 9
  ;; If not implemented, defaults to: C-9
  (t! 5app_action action_omni+9 $tab_goto_9 whatsapp nvim tmux zapzap dolphin)

  ;; omni + `
  (t! 3app_action action_omni+` XX nvim tmux dolphin)
  ;; omni + -
  (t! 3app_action action_omni+- XX nvim tmux dolphin)
  ;; omni + =
  (t! 3app_action action_omni+= XX nvim tmux dolphin)

  ;; omni + ] 
  (t! 7app_action action_omni+] XX nvim tmux chrome kiwix obsidian dolphin firefox)

  ;; omni + [ 
  (t! 7app_action action_omni+[ XX nvim tmux chrome kiwix obsidian dolphin firefox)

  ;; omni + \
  (t! 4app_action action_omni+\ XX nvim tmux foot dolphin)
  ;; omni + lsft + \
  (t! 3app_action action_omni+lsft+\ XX nvim tmux foot)
  ;; omni + rsft + \
  (t! 2app_action action_omni+rsft+\ XX nvim tmux)

  ;; omni + ;
  (t! 3app_action action_omni+; XX nvim tmux dolphin)
  ;; omni + ' 
  (t! 3app_action action_omni+' XX nvim tmux dolphin)

  ;; omni + ,
  ;; If not implemented, defaults to: action_domain,+,
  (t! 6app_action action_omni+, $settings whatsapp nvim tmux chrome zapzap firefox)
  ;; omni + .
  ;; If not implemented, defaults to: action_domain.+.
  (t! 3app_action action_omni+. $tags nvim tmux dolphin)
  ;; omni + /
  ;; If not implemented, defaults to: action_domain/+/
  (t! 2app_action action_omni+/ $help nvim tmux)

  ;; omni + !lmet|desktops
  ;; If not implemented, defaults to: action_workspaces+toggle
  (t! 2app_action action_omni+!lmet $desktops_toggle nvim tmux)
  ;; omni + !lalt|panes
  ;; If not implemented, defaults to: action_panes+toggle
  (t! 2app_action action_omni+!lalt $panes_toggle nvim tmux)
  ;; omni + !lctl|tabs
  ;; If not implemented, defaults to: action_tabs+toggle
  (t! 2app_action action_omni+!lctl $tabs_toggle nvim tmux)
  ;; omni + ralt|apps
  ;; If not implemented, defaults to: action_apps+toggle
  (t! 2app_action action_omni+ralt $apps_toggle nvim tmux)
  ;; omni + prnt|groups
  ;; If not implemented, defaults to: action_groups+toggle
  (t! 3app_action action_omni+prnt $groups_toggle nvim tmux dolphin)
  ;; omni + rctl|sessions
  ;; If not implemented, defaults to: action_sessions+toggle
  (t! 3app_action action_omni+rctl $sessions_toggle nvim tmux dolphin)

)
