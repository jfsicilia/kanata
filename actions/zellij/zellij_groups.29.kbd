(defvar

;; == groups =============================================================

;; groups + spc
zellij_action_groups+spc           $zellij_action_tabs+spc

;; groups + l | groups + right
zellij_action_groups+l             $zellij_action_tabs+l             
;; groups + h | groups + left
zellij_action_groups+h             $zellij_action_tabs+h             
;; ___TO_SET___ zellij_action_groups+j               
;; ___TO_SET___ zellij_action_groups+k               

;; ___TO_SET___ zellij_action_groups+t               
;; ___TO_SET___ zellij_action_groups+w               
;; ___TO_SET___ zellij_action_groups+lsft+t          

;; == groups go by number ==================================================
;; ___TO_SET___ zellij_action_groups+1               
;; ___TO_SET___ zellij_action_groups+2               
;; ___TO_SET___ zellij_action_groups+3               
;; ___TO_SET___ zellij_action_groups+4               
;; ___TO_SET___ zellij_action_groups+5               
;; ___TO_SET___ zellij_action_groups+6               
;; ___TO_SET___ zellij_action_groups+7               
;; ___TO_SET___ zellij_action_groups+8               
;; ___TO_SET___ zellij_action_groups+9               

;; == groups + toggle =====================================================
;; groups + toggle
zellij_action_groups+toggle        $zellij_action_tabs+toggle           

;; == groups + move =====================================================
;; ___TO_SET___ zellij_action_groups+move+h          
;; ___TO_SET___ zellij_action_groups+move+l          
;; ___TO_SET___ zellij_action_groups+move+j          
;; ___TO_SET___ zellij_action_groups+move+k          
)
