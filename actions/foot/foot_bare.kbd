(defvar
  foot_[insert|normal]_prefix_sudo_to_command          (macro x)
  foot_[normal]_beginning_of_prompt                    (macro x)
  foot_[normal]_end_of_prompt                          (macro x)
  foot_[insert|visual]_normal_mode                     (macro x)
  foot_[normal]_insert_mode                            (macro x)
  foot_[normal]_visual_mode                            (macro x)
  foot_[visual]_copy                                   (macro x)
  foot_[normal]_paste                                  (macro x)
  foot_action_bare+esc+esc   $foot_[insert|normal]_prefix_sudo_to_command
  foot_action_bare+H         $foot_[normal]_beginning_of_prompt
  foot_action_bare+L         $foot_[normal]_end_of_prompt
  foot_action_bare+esc       $foot_[insert|visual]_normal_mode
  foot_action_bare+i         $foot_[normal]_insert_mode
  foot_action_bare+v         $foot_[normal]_visual_mode
  foot_action_bare+y         $foot_[visual]_copy
  foot_action_bare+p         $foot_[normal]_paste
  foot_action_bare+tab       $foot_fuzzy_complete
)
