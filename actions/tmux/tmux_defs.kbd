;; agents
tmux_agent_select          (macro $tmux_prefix C-d)

tmux_agent_select_1        (macro $tmux_prefix C-d 100 Digit1)
tmux_agent_select_2        (macro $tmux_prefix C-d 100 Digit2)
tmux_agent_select_3        (macro $tmux_prefix C-d 100 Digit3)
