tmux_agent_next            (macro $tmux_prefix S-; r u n - s h e l l spc S-' w o r k m u x spc s i d e b a r spc n e x t S-' ent)
tmux_agent_prev            (macro $tmux_prefix S-; r u n - s h e l l spc S-' w o r k m u x spc s i d e b a r spc p r e v S-' ent)
