tmux_session_select_0        XX
tmux_session_select_1        (macro $tmux_prefix s 80 ent)
tmux_session_select_2        (macro $tmux_prefix s 80 down ent)
tmux_session_select_3        (macro $tmux_prefix s 80 down down ent)
tmux_session_select_4        (macro $tmux_prefix s 80 down down down ent)
tmux_session_select_5        (macro $tmux_prefix s 80 down down down down ent)
tmux_session_select_6        (macro $tmux_prefix s 80 down down down down down ent)
tmux_session_select_7        (macro $tmux_prefix s 80 down down down down down down ent)
tmux_session_select_8        (macro $tmux_prefix s 80 down down down down down down down ent)
tmux_session_select_9        (macro $tmux_prefix s 80 down down down down down down down down ent)

