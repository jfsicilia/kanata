(defvar
;; == workflow ============================================================
  tmux_action_workflow+spc    $tmux_worktree_select
;; ___TO_SET___ tmux_action_workflow+toggle        
  tmux_action_workflow+n      $tmux_worktree_new
  tmux_action_workflow+m      $tmux_worktree_merge
  tmux_action_workflow+w      $tmux_worktree_close
;; == workflow ============================================================
  tmux_action_workflow+bspc   $tmux_worktree_delete
  tmux_action_workflow+b      $tmux_worktree_rebase
  tmux_action_workflow+r      $tmux_worktree_rename
)
