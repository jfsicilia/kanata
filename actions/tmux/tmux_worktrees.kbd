(defvar
;; == worktrees ============================================================
  tmux_action_worktrees+spc    $tmux_worktree_select
;; ___TO_SET___ tmux_action_worktrees+toggle        
  tmux_action_worktrees+n      $tmux_worktree_new
  tmux_action_worktrees+m      $tmux_worktree_merge
  tmux_action_worktrees+w      $tmux_worktree_close
;; == worktrees ============================================================
  tmux_action_worktrees+bspc   $tmux_worktree_delete
  tmux_action_worktrees+b      $tmux_worktree_rebase
  tmux_action_worktrees+r      $tmux_worktree_rename
)
