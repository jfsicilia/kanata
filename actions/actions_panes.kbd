(defvar
  ;; == panes =============================================================
  ;; panes + spc
  (t! 0app_action action_panes+spc (push-msg "NOTIFY:Show panes not implemented!"))

  ;; panes + ent
  (t! 5app_action action_panes+ent (push-msg "NOTIFY:Maximize pane not implemented!") obsidian dolphin nvim tmux zellij)

  ;; panes + h | panes + left 
  (t! 6app_action action_panes+h (push-msg "NOTIFY:Select left pane not implemented!") obsidian dolphin colab nvim tmux zellij)
  ;; panes + l | panes + right 
  (t! 6app_action action_panes+l (push-msg "NOTIFY:Select right pane not implemented!") obsidian dolphin colab nvim tmux zellij)
  ;; panes + k | panes + up 
  (t! 6app_action action_panes+k (push-msg "NOTIFY:Select above pane not implemented!") obsidian dolphin colab nvim tmux zellij)
  ;; panes + j | panes + down 
  (t! 6app_action action_panes+j (push-msg "NOTIFY:Select below pane not implemented!") obsidian dolphin colab nvim tmux zellij)

  ;; panes + -
  (t! 4app_action action_panes+- (push-msg "NOTIFY: Horizontal split pane not implemented!") obsidian dolphin nvim tmux)
  ;; panes + \
  (t! 6app_action action_panes+\ (push-msg "NOTIFY: Vertical split pane not implemented!") chrome obsidian dolphin firefox nvim tmux)

  ;; panes + w
  (t! 4app_action action_panes+w (push-msg "NOTIFY: Close pane not implemented!") obsidian dolphin nvim tmux)

  ;; == panes + toggle ====================================================
  ;; panes + toggle | 2x !lalt
  (t! 4app_action action_panes+toggle (push-msg "NOTIFY: Toggle pane not implemented!") obsidian dolphin nvim tmux)
  
  ;; == panes + float ====================================================
  ;; panes + float
  (t! 0app_action action_panes+float (push-msg "NOTIFY: Float pane not implemented!"))

  ;; == panes + move ======================================================
  ;; panes + move + h | panes + move + left
  (t! 2app_action action_panes+move+h (push-msg "NOTIFY: Move pane left not implemented!") colab tmux)
  ;; panes + move + l | panes + move + right
  (t! 2app_action action_panes+move+l (push-msg "NOTIFY: Move pane right not implemented!") colab tmux)
  ;; panes + move + k | panes + move + up
  (t! 2app_action action_panes+move+k (push-msg "NOTIFY: Move pane up not implemented!") colab tmux)
  ;; panes + move + j | panes + move + down
  (t! 2app_action action_panes+move+j (push-msg "NOTIFY: Move pane down not implemented!") colab tmux)

  ;; == panes + resize ====================================================
  ;; panes + resize + h | panes + resize + left
  (t! 2app_action action_panes+resize+h (push-msg "NOTIFY: Resize pane left not implemented!") nvim tmux)
  ;; panes + resize + l | panes + resize + right
  (t! 2app_action action_panes+resize+l (push-msg "NOTIFY: Resize pane right not implemented!") nvim tmux)
  ;; panes + resize + k | panes + resize + up
  (t! 2app_action action_panes+resize+k (push-msg "NOTIFY: Resize pane up not implemented!") nvim tmux)
  ;; panes + resize + j | panes + resize + down
  (t! 2app_action action_panes+resize+j (push-msg "NOTIFY: Resize pane down not implemented!") nvim tmux)

  ;; == panes + swap ======================================================
  ;; panes + swap + h | panes + swap + left
  (t! 0app_action action_panes+swap+h (push-msg "NOTIFY: Swap pane left not implemented!"))
  ;; panes + swap + l | panes + swap + right
  (t! 0app_action action_panes+swap+l (push-msg "NOTIFY: Swap pane right not implemented!"))
  ;; panes + swap + k | panes + swap + up
  (t! 0app_action action_panes+swap+k (push-msg "NOTIFY: Swap pane up not implemented!"))
  ;; panes + swap + j | panes + swap + down
  (t! 0app_action action_panes+swap+j (push-msg "NOTIFY: Swap pane down not implemented!"))

  ;; == panes go by number ============================================
  ;; panes + 1
  (t! 0app_action action_panes+1 (push-msg "NOTIFY: Select pane 1 not implemented!"))
  ;; panes + 2
  (t! 0app_action action_panes+2 (push-msg "NOTIFY: Select pane 2 not implemented!"))
  ;; panes + 3
  (t! 0app_action action_panes+3 (push-msg "NOTIFY: Select pane 3 not implemented!"))
  ;; panes + 4
  (t! 0app_action action_panes+4 (push-msg "NOTIFY: Select pane 4 not implemented!"))
  ;; panes + 5
  (t! 0app_action action_panes+5 (push-msg "NOTIFY: Select pane 5 not implemented!"))
  ;; panes + 6
  (t! 0app_action action_panes+6 (push-msg "NOTIFY: Select pane 6 not implemented!"))
  ;; panes + 7
  (t! 0app_action action_panes+7 (push-msg "NOTIFY: Select pane 7 not implemented!"))
  ;; panes + 8
  (t! 0app_action action_panes+8 (push-msg "NOTIFY: Select pane 8 not implemented!"))
  ;; panes + 9
  (t! 0app_action action_panes+9 (push-msg "NOTIFY: Select pane 9 not implemented!"))

  ;; == Misc panes  ====================================================
  ;; panes + q
  (t! 0app_action action_panes+q (push-msg "NOTIFY: Quit pane not implemented!"))
  ;; panes + w 
  ;; see panes 
  ;; panes + e
  (t! 0app_action action_panes+e (push-msg "NOTIFY: Focus explorer pane not implemented!"))
  ;; panes + lsft + e
  (t! 0app_action action_panes+lsft+e (push-msg "NOTIFY: ... pane not implemented!"))
  ;; panes + r
  (t! 0app_action action_panes+r (push-msg "NOTIFY: Rename pane not implemented!"))
  ;; panes + t
  (t! 0app_action action_panes+t (push-msg "NOTIFY: Focus title pane not implemented!"))
  ;; panes + u
  (t! 0app_action action_panes+u (push-msg "NOTIFY: ... pane not implemented!"))
  ;; panes + y
  (t! 0app_action action_panes+y (push-msg "NOTIFY: ... pane not implemented!"))
  ;; panes + i
  (t! 0app_action action_panes+i (push-msg "NOTIFY: ... pane not implemented!"))
  ;; panes + o
  (t! 0app_action action_panes+o (push-msg "NOTIFY: ... pane not implemented!"))
  ;; panes + lsft + o
  (t! 0app_action action_panes+lsft+o (push-msg "NOTIFY: ... pane not implemented!"))
  ;; panes + p
  (t! 0app_action action_panes+p (push-msg "NOTIFY: ... pane not implemented!"))
  ;; panes + lsft + p
  (t! 0app_action action_panes+lsft+p (push-msg "NOTIFY: ... pane not implemented!"))
  ;; panes + [
  (t! 0app_action action_panes+[ (push-msg "NOTIFY: ... pane not implemented!"))
  ;; panes + ]
  (t! 0app_action action_panes+] (push-msg "NOTIFY: ... pane not implemented!"))
  ;; panes + lsft + ]
  (t! 0app_action action_panes+lsft+. (push-msg "NOTIFY: ... pane not implemented!"))

  ;; panes + a
  (t! 0app_action action_panes+a (push-msg "NOTIFY: ... pane not implemented!"))
  ;; panes + s
  (t! 2app_action action_panes+s (push-msg "NOTIFY: Toggle left sidebar pane not implemented!") obsidian dolphin)
  ;; panes + lsft + s
  (t! 2app_action action_panes+lsft+s (push-msg "NOTIFY: Toggle right sidebar pane not implemented!") obsidian dolphin)
  ;; panes + d
  (t! 0app_action action_panes+d (push-msg "NOTIFY: Duplicate pane not implemented!"))
  ;; panes + f
  (t! 0app_action action_panes+f (push-msg "NOTIFY: Focus find pane not implemented!"))
  ;; panes + g
  (t! 2app_action action_panes+g (push-msg "NOTIFY: Focus Go pane not implemented!") obsidian dolphin)
  ;; panes + ;
  (t! 0app_action action_panes+; (push-msg "NOTIFY: ... pane not implemented!"))
  ;; panes + '
  (t! 0app_action action_panes+' (push-msg "NOTIFY: ... pane not implemented!"))

  ;; panes + z
  (t! 0app_action action_panes+z (push-msg "NOTIFY: ... pane not implemented!"))
  ;; panes + x
  (t! 1app_action action_panes+x (push-msg "NOTIFY: ... pane not implemented!") firefox)
  ;; panes + c
  (t! 0app_action action_panes+c (push-msg "NOTIFY: ... pane not implemented!"))
  ;; panes + lsft + c
  (t! 0app_action action_panes+lsft+c (push-msg "NOTIFY: ... pane not implemented!"))
  ;; panes + rsft + c
  (t! 0app_action action_panes+!day (push-msg "NOTIFY: ... pane not implemented!"))
  ;; panes + v
  (t! 0app_action action_panes+v (push-msg "NOTIFY: ... pane not implemented!"))
  ;; panes + b
  (t! 0app_action action_panes+b (push-msg "NOTIFY: ... pane not implemented!"))
  ;; panes + n
  (t! 0app_action action_panes+n (push-msg "NOTIFY: New pane not implemented!"))
  ;; panes + m
  (t! 2app_action action_panes+m (push-msg "NOTIFY: Focus main pane not implemented!") obsidian dolphin)
  ;; panes + ,
  (t! 0app_action action_panes+, (push-msg "NOTIFY: ... pane not implemented!"))
  ;; panes + .
  (t! 0app_action action_panes+. (push-msg "NOTIFY: ... pane not implemented!"))
  ;; panes + /
  (t! 0app_action action_panes+/ (push-msg "NOTIFY: ... pane not implemented!"))

)
