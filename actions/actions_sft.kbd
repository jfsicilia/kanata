(defvar
  action_toggle_alt_keyboard        $toggle_alt_keyboard
)
(defvar
  ;; == SFT actions ==========================================================
  (t! 1app_action action_lsft+ent S-ent foot)
  (t! 1app_action action_rsft+ent S-ent foot)

  action_lsft+rsft  $action_tabs+l 

  action_rsft+lsft  $action_tabs+h 

  action_lsft+keyb (t! unmod_all $action_toggle_alt_keyboard) 
  action_rsft+keyb (t! unmod_all $action_toggle_alt_keyboard)
)
