;; This file is a placeholder interface, not a real one: the actions below
;; (esc+esc, d, i, spc, ...) are not routed from any layer in layers/*.kbd
;; and are never actually run. They exist only so kanata_gen_help.py picks
;; them up as root actions (action_bare+...) and generates a "bare" help
;; entry for the combo — pure documentation for combos that are handled
;; elsewhere (or informally), not live bindings. Adding an entry here has
;; no effect on what your keyboard does; it only affects what shows up in
;; the generated help overlay.
(defvar
  (t! 1app_action action_bare+spc XX nvim)

  (t! 1app_action action_bare+tab XX foot)
  
  (t! 1app_action action_bare+esc XX foot)

  (t! 1app_action action_bare+esc+esc XX foot)

  (t! 1app_action action_bare+H XX foot)

  (t! 1app_action action_bare+L XX foot)

  (t! 1app_action action_bare+d XX nvim)

  (t! 2app_action action_bare+i XX foot nvim)

  (t! 1app_action action_bare+p XX foot)

  (t! 1app_action action_bare+v XX foot)

  (t! 1app_action action_bare+y XX foot)
)
