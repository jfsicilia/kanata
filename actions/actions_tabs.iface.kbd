(defvar
  tab_next        C-tab
  tab_prev        C-S-tab
  tab_new         C-t
  tab_close       C-w
  tab_undo_close  C-S-t
  ;; Tabs by number
  tab_goto_0      C-0
  tab_goto_1      C-1
  tab_goto_2      C-2
  tab_goto_3      C-3
  tab_goto_4      C-4
  tab_goto_5      C-5
  tab_goto_6      C-6
  tab_goto_7      C-7
  tab_goto_8      C-8
  tab_goto_9      C-9
  tab_goto_last   C-9
)

(defvar
  ;; == tabs ===============================================================

  ;; tabs + spc 
  (t! 6app_action action_tabs+spc (push-msg "NOTIFY: Select tabs not implemented") chrome obsidian dolphin firefox nvim tmux)

  ;; tabs + l | tabs + right | lsft + rsft | 2x rsft | !lmet + tab
  ;; If not implemented, defaults to: C-tab
  (t! 8app_action action_tabs+l $tab_next whatsapp chrome zapzap obsidian firefox nvim tmux zellij)
  ;; tabs + h | tabs + left | rsft + lsft | 2x lsft | !lmet + sft + tab
  ;; If not implemented, defaults to: C-S-tab
  (t! 8app_action action_tabs+h $tab_prev whatsapp chrome zapzap obsidian firefox nvim tmux zellij)
  ;; tabs + j | tabs + down
  (t! 1app_action action_tabs+j (push-msg "NOTIFY: Select first tab not implemented") dolphin)
  ;; tabs + k | tabs + up
  (t! 1app_action action_tabs+k (push-msg "NOTIFY: Select last tab not implemented") dolphin)
  ;; tabs + r 
  ;; If not implemented, defaults to: XX
  (t! 1app_action action_tabs+r XX tmux)
  ;; tabs + t 
  ;; If not implemented, defaults to: C-t
  (t! 4app_action action_tabs+t $tab_new chrome obsidian firefox tmux)
  ;; tabs + v 
  (t! 1app_action action_tabs+v (push-msg "NOTIFY: Tabs Vertical not implemented") obsidian)
  ;; tabs + w 
  ;; If not implemented, defaults to: C-w
  (t! 5app_action action_tabs+w $tab_close chrome obsidian firefox nvim tmux)
  ;; tabs + lsft + t 
  ;; If not implemented, defaults to: C-S-t
  (t! 3app_action action_tabs+lsft+t $tab_undo_close chrome obsidian firefox)

  ;; == tabs go by number ==================================================
  ;; tabs + 1 
  ;; If not implemented, defaults to: C-1
  (t! 8app_action action_tabs+1 $tab_goto_1 whatsapp chrome zapzap obsidian dolphin firefox nvim tmux)
  ;; tabs + 2 
  ;; If not implemented, defaults to: C-2
  (t! 8app_action action_tabs+2 $tab_goto_2 whatsapp chrome zapzap obsidian dolphin firefox nvim tmux)
  ;; tabs + 3 
  ;; If not implemented, defaults to: C-3
  (t! 8app_action action_tabs+3 $tab_goto_3 whatsapp chrome zapzap obsidian dolphin firefox nvim tmux)
  ;; tabs + 4 
  ;; If not implemented, defaults to: C-4
  (t! 8app_action action_tabs+4 $tab_goto_4 whatsapp chrome zapzap obsidian dolphin firefox nvim tmux)
  ;; tabs + 5 
  ;; If not implemented, defaults to: C-5
  (t! 8app_action action_tabs+5 $tab_goto_5 whatsapp chrome zapzap obsidian dolphin firefox nvim tmux)
  ;; tabs + 6 
  ;; If not implemented, defaults to: C-6
  (t! 8app_action action_tabs+6 $tab_goto_6 whatsapp chrome zapzap obsidian dolphin firefox nvim tmux)
  ;; tabs + 7 
  ;; If not implemented, defaults to: C-7
  (t! 8app_action action_tabs+7 $tab_goto_7 whatsapp chrome zapzap obsidian dolphin firefox nvim tmux)
  ;; tabs + 8 
  ;; If not implemented, defaults to: C-8
  (t! 8app_action action_tabs+8 $tab_goto_8 whatsapp chrome zapzap obsidian dolphin firefox nvim tmux)
  ;; tabs + 9 
  ;; If not implemented, defaults to: C-9
  (t! 6app_action action_tabs+9 $tab_goto_last chrome obsidian dolphin firefox nvim tmux)

  ;; == tabs + toggle =====================================================
  ;; tabs + toggle | 2x !lctl
  (t! 7app_action action_tabs+toggle (push-msg "NOTIFY: Toggle recent tab not implemented") chrome obsidian dolphin firefox nvim tmux zellij)

  ;; == tabs + move =====================================================
  ;; tabs + move + h | tabs + move + left
  (t! 4app_action action_tabs+move+h (push-msg "NOTIFY: Move tab left not implemented") chrome dolphin firefox tmux)
  ;; tabs + move + l | tabs + move + right
  (t! 4app_action action_tabs+move+l (push-msg "NOTIFY: Move tab right not implemented") chrome dolphin firefox tmux)
  ;; tabs + move + k | tabs + move + up
  (t! 3app_action action_tabs+move+j (push-msg "NOTIFY: Move tab first not implemented") chrome dolphin firefox)
  ;; tabs + move + j | tabs + move + down
  (t! 3app_action action_tabs+move+k (push-msg "NOTIFY: Move tab last not implemented") chrome dolphin firefox)

)
