(defvar
;; This file is intended to be written by the user, and its action
;; dispatch is regenerated by the kanata_sync_apps.py script through the
;; Napp_action templates (see templates.kbd). The name of the action is
;; up to the user; to have the script keep it in sync with which apps
;; implement it, write it as:
;;
;;   (t! Napp_action <name> <default> <app1> <app2> ... <appN>)
;;
;; Example:
;;   (t! 2app_action action_lctl+a XX nvim obsidian)
;;
;; N is the number of apps that implement the action (0app_action for
;; none). <default> is the fallback used when no listed app is focused.
;; Each <appK> is an app name (matching its vk_<app> virtual key),
;; listed in priority order: when more than one app is focused at once
;; (e.g. nvim inside a tmux session), the first one in the list wins.
;; That priority order can be flipped live via the vk_apps_sort_desc
;; virtual key, which the template handles internally.
;;
;; Each app that wants its action autogenerated needs to define
;; <app>_action_<name> (same name as here, with the app prefix) in its
;; own actions/<app>/<app>_<iface>.kbd file. kanata_sync_apps.py scans
;; those files to build the <app1>...<appN> list for each action; the
;; default order of apps in the filename-less case is alphabetical, and
;; can be overridden with a numeric priority suffix on the per-app file
;; (e.g. action_nvim.1.kbd precedes action_chrome.10.kbd).

;; == omni ============================================================

;; ___TO_SET___ whatsapp_action_omni                   

;; ___TO_SET___ whatsapp_action_omni+spc               

;; ___TO_SET___ whatsapp_action_omni+ent               

;; ___TO_SET___ whatsapp_action_omni+bcsp              

;; ___TO_SET___ whatsapp_action_omni+a                 
;; ___TO_SET___ whatsapp_action_omni+lsft+a            
;; ___TO_SET___ whatsapp_action_omni+rsft+a            

;; ___TO_SET___ whatsapp_action_omni+b                 

;; ___TO_SET___ whatsapp_action_omni+c                 
;; ___TO_SET___ whatsapp_action_omni+lsft+c            
;; ___TO_SET___ whatsapp_action_omni+rsft+c            
;; ___TO_SET___ whatsapp_action_omni+c+left            
;; ___TO_SET___ whatsapp_action_omni+c+right           

;; ___TO_SET___ whatsapp_action_omni+d                 

;; ___TO_SET___ whatsapp_action_omni+e                 
;; ___TO_SET___ whatsapp_action_omni+lsft+e            

;; ___TO_SET___ whatsapp_action_omni+f                 

;; omni + g
whatsapp_action_omni+g                 $whatsapp_omni_search

;; ___TO_SET___ whatsapp_action_omni+h                 

;; ___TO_SET___ whatsapp_action_omni+i                 

;; ___TO_SET___ whatsapp_action_omni+j                 

;; ___TO_SET___ whatsapp_action_omni+k                 

;; ___TO_SET___ whatsapp_action_omni+l                 

;; ___TO_SET___ whatsapp_action_omni+m                 

;; omni + n
whatsapp_action_omni+n                 $whatsapp_new_chat
;; omni + lsft + n
whatsapp_action_omni+lsft+n            $whatsapp_new_group
;; omni + rsft + n
whatsapp_action_omni+rsft+n            $whatsapp_new_group

;; ___TO_SET___ whatsapp_action_omni+o                 

;; ___TO_SET___ whatsapp_action_omni+p                 

;; omni + q
;; If not implemented, defaults to: action_windows_close
whatsapp_action_omni+q                 $whatsapp_quit

;; ___TO_SET___ whatsapp_action_omni+r                 

;; ___TO_SET___ whatsapp_action_omni+s                 
;; ___TO_SET___ whatsapp_action_omni+lsft+s            

;; ___TO_SET___ whatsapp_action_omni+t                 
;; ___TO_SET___ whatsapp_action_omni+lsft+t            

;; ___TO_SET___ whatsapp_action_omni+u                 

;; ___TO_SET___ whatsapp_action_omni+v                 

;; ___TO_SET___ whatsapp_action_omni+w                 

;; ___TO_SET___ whatsapp_action_omni+x                 
;; ___TO_SET___ whatsapp_action_omni+x+left            
;; ___TO_SET___ whatsapp_action_omni+x+right           

;; ___TO_SET___ whatsapp_action_omni+y                 

;; ___TO_SET___ whatsapp_action_omni+z                 
;; ___TO_SET___ whatsapp_action_omni+lsft+z            


;; ___TO_SET___ whatsapp_action_omni+0                 
;; omni + 1
;; If not implemented, defaults to: C-1
whatsapp_action_omni+1                 $whatsapp_tabs_goto_1
;; omni + 2
;; If not implemented, defaults to: C-2
whatsapp_action_omni+2                 $whatsapp_tabs_goto_2
;; omni + 3
;; If not implemented, defaults to: C-3
whatsapp_action_omni+3                 $whatsapp_tabs_goto_3
;; omni + 4
;; If not implemented, defaults to: C-4
whatsapp_action_omni+4                 $whatsapp_tabs_goto_4
;; omni + 5
;; If not implemented, defaults to: C-5
whatsapp_action_omni+5                 $whatsapp_tabs_goto_5
;; omni + 6
;; If not implemented, defaults to: C-6
whatsapp_action_omni+6                 $whatsapp_tabs_goto_6
;; omni + 7
;; If not implemented, defaults to: C-7
whatsapp_action_omni+7                 $whatsapp_tabs_goto_7
;; omni + 8
;; If not implemented, defaults to: C-8
whatsapp_action_omni+8                 $whatsapp_tabs_goto_8
;; omni + 9
;; If not implemented, defaults to: C-9
whatsapp_action_omni+9                 $whatsapp_tabs_goto_9

;; ___TO_SET___ whatsapp_action_omni+`                 

;; ___TO_SET___ whatsapp_action_omni+-                 

;; ___TO_SET___ whatsapp_action_omni+=                 

;; ___TO_SET___ whatsapp_action_omni+]                 

;; ___TO_SET___ whatsapp_action_omni+[                 

;; ___TO_SET___ whatsapp_action_omni+\                 
;; ___TO_SET___ whatsapp_action_omni+lsft+\            
;; ___TO_SET___ whatsapp_action_omni+rsft+\            

;; ___TO_SET___ whatsapp_action_omni+;                 

;; ___TO_SET___ whatsapp_action_omni+'                 

;; omni + ,
;; If not implemented, defaults to: action_domain,+,
whatsapp_action_omni+,                 $whatsapp_settings

;; ___TO_SET___ whatsapp_action_omni+.                 

;; ___TO_SET___ whatsapp_action_omni+/                 

;; ___TO_SET___ whatsapp_action_omni+!lmet             

;; ___TO_SET___ whatsapp_action_omni+!lalt             

;; ___TO_SET___ whatsapp_action_omni+!lctl             

;; ___TO_SET___ whatsapp_action_omni+ralt              

;; ___TO_SET___ whatsapp_action_omni+prnt              

;; ___TO_SET___ whatsapp_action_omni+rctl              
)
