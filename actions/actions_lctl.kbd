  (t! 0app_action action_lctl+rsft+e C-S-e)
  (t! 0app_action action_lctl+rsft+f C-S-f)
  (t! 0app_action action_lctl+rsft+g C-S-g)
  (t! 0app_action action_lctl+rsft+h C-S-h)
  (t! 0app_action action_lctl+rsft+i C-S-i)
  (t! 0app_action action_lctl+rsft+j C-S-j)
  (t! 0app_action action_lctl+rsft+k C-S-k)
  (t! 0app_action action_lctl+rsft+l C-S-l)
  (t! 0app_action action_lctl+rsft+m C-S-m)
  (t! 0app_action action_lctl+rsft+n C-S-n)
  (t! 0app_action action_lctl+rsft+o C-S-o)
  (t! 0app_action action_lctl+rsft+p C-S-p)
  (t! 0app_action action_lctl+rsft+q C-S-q)
  (t! 0app_action action_lctl+rsft+r C-S-r)
  (t! 0app_action action_lctl+rsft+s C-S-s)
  (t! 0app_action action_lctl+rsft+t C-S-t)
  (t! 0app_action action_lctl+rsft+u C-S-u)
  (t! 0app_action action_lctl+rsft+v C-S-v)
  (t! 0app_action action_lctl+rsft+w C-S-w)
  (t! 0app_action action_lctl+rsft+x C-S-x)
  (t! 0app_action action_lctl+rsft+y C-S-y)
  (t! 0app_action action_lctl+rsft+z C-S-z)
  (t! 0app_action action_lctl+rsft+, C-S-,)
  (t! 0app_action action_lctl+rsft+. C-S-.)
  (t! 0app_action action_lctl+rsft+/ C-S-/)
  (t! 0app_action action_lctl+rsft+; C-S-;)
  (t! 0app_action action_lctl+rsft+' C-S-')
  (t! 0app_action action_lctl+rsft+[ C-S-[)
  (t! 0app_action action_lctl+rsft+] C-S-])
  (t! 0app_action action_lctl+rsft+\ C-S-\)
  (t! 0app_action action_lctl+rsft+- C-S--)
