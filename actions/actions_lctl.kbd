(defvar
  ;; Virtual key vk_lalt is "pressed" on first tab pressed and will be
  ;; "released" when lclt is released.
  walk_through_apps (switch 
    ((input virtual vk_lalt)) (unmod (lctl) tab) break
    () (multi (on-press press-vkey vk_lalt) lalt (unmod (lctl) tab)) break
  )
  ;; Virtual key vk_lalt is "pressed" on first ` pressed and will be
  ;; "released" when lclt is released.
  walk_through_same_app (switch 
    ((input virtual vk_lalt)) (unmod (lctl) grv) break
    () (multi (on-press press-vkey vk_lalt) lalt (unmod (lctl) grv)) break
  )

  ;; == LCTL actions ==========================================================
  action_lctl+tab $walk_through_apps
  action_lctl+` $walk_through_same_app
  (t! 1app_action action_lctl+spc C-spc foot)

  (t! 0app_action action_lctl+a C-a)
  (t! 1app_action action_lctl+b C-b obsidian)
  (t! 0app_action action_lctl+c C-c)
  (t! 1app_action action_lctl+d C-d foot)
  (t! 1app_action action_lctl+e C-e foot)
  (t! 2app_action action_lctl+f C-f obsidian foot)
  (t! 0app_action action_lctl+g C-g)
  (t! 1app_action action_lctl+h C-h foot)
  (t! 1app_action action_lctl+i C-i foot)
  (t! 1app_action action_lctl+j C-j foot)
  (t! 0app_action action_lctl+k C-k)
  (t! 1app_action action_lctl+l C-l foot)
  (t! 1app_action action_lctl+m C-m foot)
  (t! 1app_action action_lctl+n C-n foot)
  (t! 0app_action action_lctl+o C-o)
  (t! 1app_action action_lctl+p C-p foot)
  (t! 0app_action action_lctl+q C-q)
  (t! 1app_action action_lctl+r C-r foot)
  (t! 0app_action action_lctl+s C-s)
  (t! 1app_action action_lctl+t C-t obsidian)
  (t! 1app_action action_lctl+u C-u foot)
  (t! 0app_action action_lctl+v C-v)
  (t! 1app_action action_lctl+w C-w foot)
  (t! 0app_action action_lctl+x C-x)
  (t! 1app_action action_lctl+y C-y foot)
  (t! 0app_action action_lctl+z C-z)
  (t! 1app_action action_lctl+, C-, obsidian)
  (t! 0app_action action_lctl+. C-.)
  (t! 0app_action action_lctl+/ C-/)
  (t! 1app_action action_lctl+; C-; obsidian)
  (t! 0app_action action_lctl+' C-')
  (t! 1app_action action_lctl+[ C-[ obsidian)
  (t! 1app_action action_lctl+] C-] obsidian)
  (t! 0app_action action_lctl+\ C-\)
  (t! 0app_action action_lctl+- C--)
  (t! 0app_action action_lctl+= C-=)
  (t! 3app_action action_lctl+1 C-1 firefox nvim tmux)
  (t! 3app_action action_lctl+2 C-2 firefox nvim tmux)
  (t! 3app_action action_lctl+3 C-3 firefox nvim tmux)
  (t! 3app_action action_lctl+4 C-4 firefox nvim tmux)
  (t! 3app_action action_lctl+5 C-5 firefox nvim tmux)
  (t! 3app_action action_lctl+6 C-6 firefox nvim tmux)
  (t! 3app_action action_lctl+7 C-7 firefox nvim tmux)
  (t! 3app_action action_lctl+8 C-8 firefox nvim tmux)
  (t! 3app_action action_lctl+9 C-9 firefox nvim tmux)
  (t! 1app_action action_lctl+0 C-0 firefox)

  ;; == LCTL+LSFT actions ==========================================================
  (t! 0app_action action_lctl+lsft+tab C-S-tab)
  (t! 0app_action action_lctl+lsft+` C-S-`)
  (t! 0app_action action_lctl+lsft+spc C-S-spc)

  (t! 0app_action action_lctl+lsft+a C-S-a)
  (t! 0app_action action_lctl+lsft+b C-S-b)
  (t! 1app_action action_lctl+lsft+c C-S-c foot)
  (t! 0app_action action_lctl+lsft+d C-S-d)
  (t! 0app_action action_lctl+lsft+e C-S-e)
  (t! 0app_action action_lctl+lsft+f C-S-f)
  (t! 0app_action action_lctl+lsft+g C-S-g)
  (t! 0app_action action_lctl+lsft+h C-S-h)
  (t! 0app_action action_lctl+lsft+i C-S-i)
  (t! 0app_action action_lctl+lsft+j C-S-j)
  (t! 0app_action action_lctl+lsft+k C-S-k)
  (t! 0app_action action_lctl+lsft+l C-S-l)
  (t! 0app_action action_lctl+lsft+m C-S-m)
  (t! 0app_action action_lctl+lsft+n C-S-n)
  (t! 0app_action action_lctl+lsft+o C-S-o)
  (t! 0app_action action_lctl+lsft+p C-S-p)
  (t! 0app_action action_lctl+lsft+q C-S-q)
  (t! 0app_action action_lctl+lsft+r C-S-r)
  (t! 0app_action action_lctl+lsft+s C-S-s)
  (t! 1app_action action_lctl+lsft+t C-S-t obsidian)
  (t! 0app_action action_lctl+lsft+u C-S-u)
  (t! 1app_action action_lctl+lsft+v C-S-v foot)
  (t! 0app_action action_lctl+lsft+w C-S-w)
  (t! 0app_action action_lctl+lsft+x C-S-x)
  (t! 0app_action action_lctl+lsft+y C-S-y)
  (t! 0app_action action_lctl+lsft+z C-S-z)
  (t! 0app_action action_lctl+lsft+, C-S-,)
  (t! 0app_action action_lctl+lsft+. C-S-.)
  (t! 0app_action action_lctl+lsft+/ C-S-/)
  (t! 0app_action action_lctl+lsft+; C-S-;)
  (t! 0app_action action_lctl+lsft+' C-S-')
  (t! 0app_action action_lctl+lsft+[ C-S-[)
  (t! 0app_action action_lctl+lsft+] C-S-])
  (t! 0app_action action_lctl+lsft+\ C-S-\)
  (t! 0app_action action_lctl+lsft+- C-S--)
  (t! 0app_action action_lctl+lsft+= C-S-=)
  (t! 0app_action action_lctl+lsft+1 C-S-1)
  (t! 0app_action action_lctl+lsft+2 C-S-2)
  (t! 0app_action action_lctl+lsft+3 C-S-3)
  (t! 0app_action action_lctl+lsft+4 C-S-4)
  (t! 0app_action action_lctl+lsft+5 C-S-5)
  (t! 0app_action action_lctl+lsft+6 C-S-6)
  (t! 0app_action action_lctl+lsft+7 C-S-7)
  (t! 0app_action action_lctl+lsft+8 C-S-8)
  (t! 0app_action action_lctl+lsft+9 C-S-9)
  (t! 0app_action action_lctl+lsft+0 C-S-0)

  ;; == LCTL+RSFT actions ==========================================================
  (t! 0app_action action_lctl+rsft+tab C-S-tab)
  (t! 0app_action action_lctl+rsft+` C-S-`)
  (t! 0app_action action_lctl+rsft+spc C-S-spc)

  (t! 0app_action action_lctl+rsft+a C-S-a)
