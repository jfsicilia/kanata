(defvar
  ;; == sessions =====================================================
  ;; sessions + spc
  (t! 1app_action action_sessions+spc XX tmux)
  ;; sessions + toggle
  (t! 0app_action action_sessions+toggle XX)
  (t! 1app_action action_sessions+d XX tmux)
  (t! 1app_action action_sessions+h XX tmux)
  (t! 1app_action action_sessions+j XX tmux)
  (t! 1app_action action_sessions+k XX tmux)
  (t! 1app_action action_sessions+l XX tmux)
  (t! 1app_action action_sessions+w XX tmux)
  (t! 1app_action action_sessions+r XX tmux)

)
